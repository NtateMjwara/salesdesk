# SalesDesk — Apache routing rules
# T1 owns this file.
# Place in the public/ directory (web root).
#
# Two public URL formats (Decision D-01, taskboard pl1):
#
#   Route A — share link:
#     /c/{car-slug}?ref={tracking_code}
#     → public/c/{car-slug}/index.php
#     Resolves tracking code, renders lead form.
#
#   Route B — broker desk storefront:
#     /{broker-slug}/
#     /{broker-slug}/{anything}
#     → public/broker/{broker-slug}/index.php
#     Public inventory page for a broker's desk.
#
# Internal routes (auth, app, api) are NOT rewritten here —
# they map directly to their directory paths.
#
# Security rules are also defined here:
#   - Block direct access to includes/, db/, cron/, scripts/
#   - Block .env, .sql, composer files
#   - Force HTTPS in production

Options -Indexes
ServerSignature Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # ── HTTPS redirect (enable in production) ──────────────────
  # Uncomment when SSL certificate is in place.
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── Block access to sensitive directories ──────────────────
  # These directories sit above or alongside public/ in the
  # project layout but may be accessible if the web root is
  # misconfigured. Belt-and-suspenders.
  RewriteRule ^(includes|db|cron|scripts|vendor)(/|$) - [F,L]

  # ── Block sensitive file types ─────────────────────────────
  RewriteRule \.(env|sql|log|sh|bak|git)$ - [F,L]
  RewriteRule ^(composer\.(json|lock)|package(-lock)?\.json)$ - [F,L]

  # ── Pass real files and directories through unchanged ───────
  # Prevents rewrites from breaking /assets/, /api/, /auth/, etc.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ── Route A: /c/{car-slug} → share link handler ─────────────
  # Matches: /c/2022-toyota-corolla-cross or /c/2022-toyota-corolla-cross/
  # The ?ref={tracking_code} query string passes through automatically.
  # T4 builds: public/c/{car-slug}/index.php
  RewriteRule ^c/([a-z0-9-]+)/?$ /c/$1/index.php [L,QSA]

  # ── Route B: /{broker-slug}/ → broker desk storefront ───────
  # Matches: /sipho-d/ or /sipho-d/anything
  # Must come AFTER Route A to avoid catching /c/ paths.
  # Slug format enforced: lowercase letters, numbers, hyphens only.
  # Excludes known top-level directories: auth, app, api, public, assets.
  RewriteCond %{REQUEST_URI} !^/(auth|app|api|assets|c|admin|uploads)(/|$)
  RewriteRule ^([a-z0-9][a-z0-9-]{1,59})/?$ /broker/$1/index.php [L,QSA]

</IfModule>

# ── Security headers (fallback if not set in PHP) ────────────
# layout files set these via PHP header() calls; these are
# belt-and-suspenders for any static assets served directly.
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Static asset caching ────────────────────────────────────
# Versioned assets (?v=YYYYMMDD) can be cached aggressively.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 1 month"
  ExpiresByType image/png                 "access plus 1 month"
  ExpiresByType image/webp                "access plus 1 month"
  ExpiresByType image/svg+xml             "access plus 1 month"
  ExpiresByType application/pdf           "access plus 1 week"
</IfModule>

# ── Disable ETags for versioned assets ─────────────────────
FileETag None
