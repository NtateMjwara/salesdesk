# ============================================================
# SalesDesk — Apache URL Rewriting
# Place this file in the web root (public_html/ or equivalent).
#
# Route map:
#   /cars-for-sale/                          → cars-for-sale/index.php         (browse all)
#   /cars-for-sale/{desk-slug}/{car-slug}/   → cars-for-sale/car-detail/index.php   (detail)
#   /{broker-slug}/                          → broker/index.php         (storefront)
#   /news/{slug}/                            → news/article.php         (blog article)
#   /newsletter/confirmed.php                → newsletter/newsletter-confirmed.php
#   /newsletter/unsubscribe/                 → newsletter/newsletter-unsubscribe.php
#
# ROUTE RENAME (this pass): /c/ → /cars-for-sale/
#   The browse and car-detail routes were previously served from the
#   c/ directory at /c/ and /c/{desk-slug}/{car-slug}/. Both the
#   directory and every route below have moved to cars-for-sale/.
#   A legacy 301 redirect block is included further down so any
#   previously indexed or shared /c/... URL still resolves correctly
#   instead of 404ing.
#
# Attribution model (v2):
#   Every car detail URL now carries the desk slug in the path.
#   ?ref={tracking_code} is still appended for externally shared links
#   but is optional — the desk slug alone is sufficient for attribution.
#
# Reserved paths must come BEFORE the broker storefront catch-all.
#
# Stack: Apache 2.4 + mod_rewrite + PHP 8.x
# ============================================================

Options -Indexes
Options +FollowSymLinks

# ── PERF-1: Browser cache headers ───────────────────────────
# Versioned assets (?v=YYYYMMDD) are immutable — cache 1 year.
# Images cache 30 days. Fonts cache 1 year.
<IfModule mod_expires.c>
  ExpiresActive On

  <FilesMatch "\.(css|js)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpg|jpeg|webp|svg|ico|gif)$">
    ExpiresDefault "access plus 30 days"
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.(woff2|woff|ttf)$">
    ExpiresDefault "access plus 1 year"
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ── PERF-2: Gzip compression ────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain application/json
</IfModule>

# ── PERF-3: Vary header for proxy/CDN correctness ───────────
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    Header append Vary Accept-Encoding
  </FilesMatch>
</IfModule>

RewriteEngine On

# ── Security: block direct access to sensitive directories ──
RewriteRule ^(includes|vendor|db|views)/      - [F,L]
RewriteRule ^\.                               - [F,L]
RewriteRule ^(config\.php|composer\.(json|lock))$ - [F,L]

# ── Remove trailing index.php ────────────────────────────────
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.+/)?index\.php [NC]
RewriteRule ^ /%1 [R=301,L]

# ── Enforce HTTPS in production ──────────────────────────────
# Uncomment when SSL certificate is active:
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ── Static assets — serve directly ──────────────────────────
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ── LEGACY: /c/ → /cars-for-sale/ (301 redirect) ─────────────
# Preserves previously indexed/shared links after the route rename.
# Must come before the new cars-for-sale rules so old links redirect
# instead of falling through to a 404.
RewriteRule ^c/?$ /cars-for-sale/ [R=301,L]
RewriteRule ^c/([a-z0-9][a-z0-9\-]{1,59})/([a-z0-9][a-z0-9\-]{1,99})/?$ /cars-for-sale/$1/$2/ [R=301,L,QSA]

# ── /cars-for-sale/ — Browse all cars ────────────────────────
RewriteRule ^cars-for-sale/?$ cars-for-sale/index.php [L]

# ── /cars-for-sale/{desk-slug}/{car-slug}/ — Car detail (v2, desk-attributed) ──
# Both slugs: lowercase letters, digits, hyphens only.
# desk-slug: 2–60 chars | car-slug: 2–100 chars
# QSA preserves ?ref= for externally shared tracked links.
RewriteRule ^cars-for-sale/([a-z0-9][a-z0-9\-]{1,59})/([a-z0-9][a-z0-9\-]{1,99})/?$ cars-for-sale/car-detail/index.php?desk_slug=$1&car_slug=$2 [L,QSA]

# ── Reserved top-level paths — route directly ────────────────
# Must come BEFORE the broker storefront catch-all below.
RewriteRule ^(app|api|auth|assets|uploads|public|includes|views|vendor|db|cars-for-sale)(/.*)?$ $0 [L]
RewriteRule ^(brokers|dealers|privacy|terms|sitemap)(\.php)?$ $0 [L]

# ── /news/{slug}/ — Blog article detail ──────────────────────
# slug: lowercase letters, digits, hyphens (2–150 chars)
RewriteRule ^news/([a-z0-9][a-z0-9\-]{1,149})/?$ news/article.php?slug=$1 [L,QSA]

# ── /newsletter/confirmed.php — Confirm / error state page ───
# Actual file is newsletter/newsletter-confirmed.php (name differs from route).
RewriteRule ^newsletter/confirmed\.php$ newsletter/newsletter-confirmed.php [L,QSA]

# ── /newsletter/unsubscribe/ — One-click unsubscribe ──────────
# Actual file is newsletter/newsletter-unsubscribe.php (name differs from route).
RewriteRule ^newsletter/unsubscribe/?$ newsletter/newsletter-unsubscribe.php [L,QSA]

# ── /{broker-slug}/ — Broker public storefront ───────────────
# Catch-all: any remaining slug-like path routes to the storefront.
RewriteRule ^([a-z][a-z0-9\-]{1,59})/?$ broker/index.php?slug=$1 [L,QSA]

# ── 404 fallback ─────────────────────────────────────────────
ErrorDocument 404 /broker/404.php
ErrorDocument 500 /broker/404.php
